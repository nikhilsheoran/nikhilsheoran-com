# Copy to .env.local and fill in. Never commit real values.

# Public address of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres, transaction pooler connection string. Server only.
# Supabase dashboard > Connect > Transaction pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Better Auth. Server only. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in (Google Cloud console > Credentials). Server only.
# Authorised redirect: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
